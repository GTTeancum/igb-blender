<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Alchemy Batch Converter" Width="1320" Height="960" MinWidth="1000" MinHeight="720" Background="#17191D" Foreground="#F0F1F3" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#B62D3A"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="5"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#24272D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#434852"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#15171A"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C7CBD2"/><Setter Property="Margin" Value="0,8,15,8"/></Style>
<Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
</Window.Resources>
<Grid Margin="24" Background="#17191D"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="ALCHEMY" FontSize="27" FontWeight="Bold"/><TextBlock Text="Batch converter · powered by igb-blender" Foreground="#A6ABB5"/></StackPanel><TextBlock Text="SOURCE SAFE / SEPARATE OUTPUT" HorizontalAlignment="Right" Foreground="#CC6973"/></DockPanel>
<Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<TextBlock Text="Source"/><TextBox Name="Source" Grid.Column="1"/><Button Name="BrowseSource" Grid.Column="2" Content="Browse…"/>
<TextBlock Grid.Row="1" Text="Output"/><TextBox Name="Output" Grid.Row="1" Grid.Column="1"/><Button Name="BrowseOutput" Grid.Row="1" Grid.Column="2" Content="Browse…"/>
<TextBlock Grid.Row="2" Text="Blender"/><TextBox Name="Blender" Grid.Row="2" Grid.Column="1"/><Button Name="BrowseBlender" Grid.Row="2" Grid.Column="2" Content="Browse…"/>
</Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
<DockPanel LastChildFill="False"><Button Name="Scan" Content="Scan folder" DockPanel.Dock="Right"/><CheckBox Name="Recursive" Content="Include subfolders" IsChecked="True"/><Button Name="SelectAll" Content="Select all" Background="#353A43"/><Button Name="SelectNone" Content="Clear" Background="#353A43"/></DockPanel>
<DataGrid Name="Assets" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#202329" Foreground="#EFEFF1" RowBackground="#24272D" AlternatingRowBackground="#202329" BorderBrush="#41454D" GridLinesVisibility="None" HeadersVisibility="Column" SelectionMode="Single" RowHeight="36">
<DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#353A43"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Padding" Value="8"/></Style></DataGrid.Resources>
<DataGrid.Columns><DataGridCheckBoxColumn Header="✓" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="36"/><DataGridTextColumn Header="Asset" Binding="{Binding Relative}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="105" IsReadOnly="True"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
<TextBox Name="Detail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Scan a folder to inspect its IGB assets. Select a row for format and compatibility details."/>
</Grid>
<Border Grid.Column="2" Background="#22252B" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="TARGET PRESET" FontWeight="Bold" Foreground="#E18189" Margin="0,0,0,8"/><ComboBox Name="Preset"/><TextBlock Name="Layout" TextWrapping="Wrap" Foreground="#A6ABB5" Margin="0,0,0,14"/>
<TextBlock Text="Source profile"/><ComboBox Name="Profile"/><TextBlock Text="Texture format" Margin="0,8,0,0"/><ComboBox Name="Texture"/><TextBlock Text="Maximum texture size" Margin="0,8,0,0"/><ComboBox Name="Size"/>
<CheckBox Name="Mipmaps" Content="Generate mipmaps"/><CheckBox Name="Maps" Content="Keep additional maps when present"/>
<TextBlock Text="ASSET HANDLING" FontWeight="Bold" Foreground="#E18189" Margin="0,18,0,8"/>
<TextBlock Text="Supported characters / static scenes"/><ComboBox Name="Supported"><ComboBoxItem Content="Convert"/><ComboBoxItem Content="Copy unchanged"/><ComboBoxItem Content="Skip"/></ComboBox>
<TextBlock Text="Animations / UI / effects / unsupported" TextWrapping="Wrap"/><ComboBox Name="Unsupported"><ComboBoxItem Content="Skip"/><ComboBoxItem Content="Copy unchanged"/></ComboBox>
<TextBlock Text="Folder structure is preserved. Originals and existing outputs are never overwritten. Copy keeps the original format." TextWrapping="Wrap" Foreground="#A6ABB5" Margin="0,10,0,8"/>
<Button Name="SavePreset" Content="Save settings…" Background="#353A43"/><Button Name="LoadPreset" Content="Load settings…" Background="#353A43"/>
</StackPanel></ScrollViewer></Border></Grid>
<ProgressBar Name="Progress" Grid.Row="3" Height="5" Margin="0,16,0,10" Foreground="#C53745" Background="#33363C"/>
<DockPanel Grid.Row="4"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Name="Report" Content="Export report…" Background="#353A43"/><Button Name="Cancel" Content="Cancel" Background="#353A43" IsEnabled="False"/><Button Name="Convert" Content="Convert selected"/></StackPanel><TextBlock Name="Status" Text="Ready · Blender 4.5 required" TextWrapping="Wrap"/></DockPanel>
</Grid></Window>
